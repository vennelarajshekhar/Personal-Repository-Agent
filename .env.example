# Copy this file to .env and fill in LLM_API_KEY.
# The agent loads .env automatically from the project root.

LLM_API_KEY=
OPENAI_API_KEY=

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Leave REPO_ROOT empty locally so sample_repo is used.
# Docker Compose sets /app/sample_repo for you.
# REPO_ROOT=

AGENT_ALLOW_TESTS=true
AGENT_READ_ONLY=false
AGENT_MAX_STEPS=12
AGENT_COMMAND_TIMEOUT=30
